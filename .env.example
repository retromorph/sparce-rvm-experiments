# Copy to .env on the remote GPU host. Never commit real credentials.
HF_HOME=./.cache/huggingface
HF_HUB_DISABLE_TELEMETRY=1
TOKENIZERS_PARALLELISM=false
MLFLOW_TRACKING_URI=http://127.0.0.1:5000
MLFLOW_EXPERIMENT_NAME=sparce-poc
CUDA_VISIBLE_DEVICES=0
# For SSH commands, configure a host alias in ~/.ssh/config (not in this file).
